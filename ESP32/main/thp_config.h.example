/*
 * THP 上报本地配置模板
 *
 * 用法：
 *   copy thp_config.h.example thp_config.h
 *   填入真实 Wi-Fi 与设备 Token 后再编译烧录。
 *
 * 安全（REQUIREMENTS.md §12.7）：
 *   thp_config.h 已被 .gitignore 忽略，明文 Token / 密码不得提交到仓库。
 *   Token 在 Dash「管理 → 生成上报 Token」获得，明文只显示一次。
 */
#pragma once

/* ---------------- Wi-Fi STA ---------------- */
#define THP_WIFI_SSID           "your-wifi-ssid"
#define THP_WIFI_PASSWORD       "your-wifi-password"

/* 最长等待 Wi-Fi 连接成功的时间（毫秒）；超时后进入重试循环 */
#define THP_WIFI_CONNECT_TIMEOUT_MS  30000

/* STA 最大发射功率（dBm），有效约 8~20。
 * 部分 ESP32-C3 Super Mini 板载天线差：默认 20 dBm 时开放认证易失败
 * （AUTH_EXPIRE / reason=2），或连上极不稳定。参考
 * G:\esp32s3\esp32c3-ir-web-ESP32-C3 默认压到 15 dBm。
 * 仍连不上可再降到 8~12；信号远、丢包多时可略升（勿超过 20）。
 */
#define THP_WIFI_STA_TX_POWER_DBM   15

/* ---------------- THP API ----------------
 * 线上 Workers / 自定义域名示例：
 *   https://thp-dash.<your-subdomain>.workers.dev
 * 本地 wrangler dev 示例（设备须与电脑同一局域网）：
 *   http://192.168.1.10:8787
 * 固件会自动在末尾拼接 /api/v1/readings
 * 注意：不要写 127.0.0.1 —— ESP32 上的 127.0.0.1 是它自己。
 */
#define THP_API_BASE            "http://127.0.0.1:8787"

/* 设备上报 Token（Bearer，形如 thp_xxx）。在 Dash 登录后生成。 */
#define THP_DEVICE_TOKEN        "thp_replace_me"

/* 可选：设备 ID。必须与 Token 绑定设备一致；留空则不发送该字段
 * （服务端以 Token 绑定的 device_id 为准，见 REQUIREMENTS.md §4.4）
 */
#define THP_DEVICE_ID           ""

/* ---------------- 上报节奏 ----------------
 * 需求：5 分钟 / 次（288 条 / 设备 / 天）
 */
#define THP_REPORT_PERIOD_MS    (5 * 60 * 1000)

/* Wi-Fi/NTP 就绪后首次上报前的等待（毫秒），便于串口观察初始化 */
#define THP_REPORT_FIRST_DELAY_MS  5000

/* 上报失败时的有限重试次数与基础退避（毫秒），不无限重发 */
#define THP_REPORT_MAX_RETRIES  3
#define THP_REPORT_RETRY_BASE_MS 2000

/* ---------------- 离线补传 ----------------
 * 网络/5xx 重试仍失败时入队；恢复后按时间顺序补传（body 带历史 ts）。
 * 288 ≈ 5 分钟周期 × 24h；队列满丢最旧。仅 RAM，断电不保留。
 * 补传条与条之间的间隔（毫秒），避免瞬时打满接口。
 * 每周期最多补传条数：限制积压排空对当前采样的阻塞。
 */
#define THP_OFFLINE_QUEUE_LEN     288
#define THP_OFFLINE_FLUSH_GAP_MS  200
#define THP_OFFLINE_FLUSH_MAX_PER_CYCLE  24

/* 单次 HTTP(S) 请求总超时（毫秒）。
 * C3 上 BLE/Wi-Fi 共存，握手偏慢；15s 为预算与假失败的折中。
 * 连接 keep-alive 复用落地前，不建议压到 12s 以下。
 */
#define THP_HTTP_TIMEOUT_MS     15000

/* 周期 deadline = THP_REPORT_PERIOD_MS - margin。
 * report/flush 在 deadline 后不再发起 HTTP；本地采样与 MI 缓存仍会入离线队列。
 */
#define THP_CYCLE_DEADLINE_MARGIN_MS  20000

/* ---------------- NTP（measured_at；入库时间仍以服务端为准） ----------------
 * 已同步时跳过；每 N 个周期才重启 SNTP 重同步（漂移检测二期）。
 * 服务器数量须 ≤ CONFIG_LWIP_SNTP_MAX_SERVERS（sdkconfig.defaults 已设 4）。
 * 国内优先：阿里云 / 国家授时中心；pool 作兜底。
 */
#define THP_NTP_RESYNC_EVERY_CYCLES   12
#define THP_NTP_NUM_SERVERS         4
#define THP_NTP_SERVER_LIST ESP_SNTP_SERVER_LIST( \
    "ntp.aliyun.com", \
    "cn.pool.ntp.org", \
    "ntp.ntsc.ac.cn", \
    "pool.ntp.org")
/* 单次上报前等待 NTP 同步的超时（毫秒） */
#define THP_NTP_SYNC_TIMEOUT_MS     20000

/* 设为 1 时跳过 HTTPS 证书校验（仅本地 http 调试或自签证书排查用） */
#define THP_HTTP_SKIP_VERIFY    0

/* ---------------- 小米温湿度计 2（pvvx ATC · BLE 网关） ----------------
 * 同板 ESP32-C3：I2C 本机传感器用 Token A；小米计 BLE 解出后用 Token B。
 * 云端零改动：Dash 里另建设备并生成 Token。
 */
#ifndef THP_MI_ENABLE
#define THP_MI_ENABLE 1
#endif

/* Dash 为小米计生成的上报 Token（与 THP_DEVICE_TOKEN 分开） */
#define THP_MI_DEVICE_TOKEN  "thp_replace_me_mi"

/* 可选：须与 Token B 绑定设备一致；留空则不发送 device_id */
#define THP_MI_DEVICE_ID     ""

/* 目标 MAC（显示序）。界面「Device MAC [+ 2 Rand]」常显示 8 字节，
 * 取前 6 字节填入；若串口 ATC 帧日志 MAC 不同，以日志为准。
 * 示例：A4:C1:38:E2:4E:43
 */
#define THP_MI_MAC           "A4:C1:38:E2:4E:43"

/* pvvx 配置页「BindKey」（32 hex，16 字节）——加密 beacon 使用。
 * 注意：是 BindKey，不是 Mi Bind Key（v4.4+ 仅 EEP BindKey 生效）。
 * Encrypted beacon 关闭时可留全 0；开启后必须填写。
 */
#define THP_MI_BINDKEY       "00000000000000000000000000000000"

/* 上报前主动扫描窗口（毫秒）；【持续扫描模式下已不再使用】
 * 固件改为后台一直扫，上报时取「本周期内最近一帧」。 */
#define THP_MI_SCAN_BEFORE_REPORT_MS   8000

/* 样本最大年龄：超过则本周期不报 MI（建议 ≥2× 上报周期） */
#define THP_MI_MAX_AGE_MS              (3 * THP_REPORT_PERIOD_MS)
