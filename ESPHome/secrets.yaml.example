# 复制为 secrets.yaml 后填写。secrets.yaml 已 gitignore，勿提交。
# Token 在 Dash「管理 → 生成上报 Token」，明文只显示一次。

wifi_ssid: "YourWiFi"
wifi_password: "YourWiFiPassword"
ap_password: "setup-pass"          # 配网热点
api_encryption_key: "BASE64_32B_KEY_FROM_ESPHOME="
ota_encryption_key: "BASE64_32B_KEY_FROM_ESPHOME="

# Worker 上报地址（完整路径）
thp_readings_url: "https://dash.example.com/api/v1/readings"

# LOCAL（SHT40+BMP280）设备 Token，含 "Bearer "
thp_local_auth: "Bearer thp_xxx_local"
# MI（小米计）设备 Token，与 LOCAL 分开
thp_mi_auth: "Bearer thp_xxx_mi"

# 小米计 BLE（BTHome v2）
thp_mi_mac: "A4:C1:38:00:00:00"
# BTHome 加密 bindkey（16 字节 hex）；明文广播可删掉 bthome 的 bindkey 行或填空
thp_mi_bindkey: "00000000000000000000000000000000"
